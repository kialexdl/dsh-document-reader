{
  "name": "dsh-document-reader",
  "version": "0.3.4",
  "description": "DSH Office/PDF reading and keyword search with revision-safe navigation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "python/*.py",
    "python/*.txt",
    "python/*.lock",
    "python/*.json",
    "prompts",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "package:source": "python3 scripts/package-source.py",
    "check": "pnpm build && pnpm test && pnpm test:package",
    "test:package": "node scripts/check-package.mjs",
    "package:github": "npm run build && npm run test:package && python3 scripts/package-source.py --include-built"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "node-addon-require-builtin": "0.1.6",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  }
}
